*.o
# Bundled prebuilt musl C runtime objects -- shipped with the SDK like
# libc.a/libm.a so a fresh checkout can link without building musl. The
# broad *.o rule above would otherwise drop them and break the link.
!src/sdk/musl/lib/crt1.o
!src/sdk/musl/lib/crti.o
!src/sdk/musl/lib/crtn.o
*.elf
._*
app_pc
save_*.bin
build/
.obj/
# Downloader DBs are committed and served via raw.githubusercontent — a
# stable per-game db_url independent of the repo-wide releases/latest pointer.
releases/*
!releases/mister/
releases/mister/*
!releases/mister/*.json.zip
!releases/mister/*.downloader.ini
src/tools/phdp/phdp
src/tools/phdp/phdpd
.DS_Store
